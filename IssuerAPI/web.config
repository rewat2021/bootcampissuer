<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ให้ .well-known/* ไปที่ ASP.NET Core แทนที่จะ block -->
    <handlers>
      <add name="WellKnown"
           path=".well-known/*"
           verb="GET"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified"
           requireAccess="None" />
    </handlers>

    <!-- ASP.NET Core handler หลัก -->
    <aspNetCore processPath="dotnet"
                arguments=".\IssuerAPI.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <!--
        C-06: ไฟล์นี้ถูกเพิ่มเข้า .gitignore แล้ว (IssuerAPI/web.config) ก่อนใส่ค่าจริงด้านล่าง —
        ถ้าไฟล์นี้เคย commit มาก่อนตอนที่ยังไม่มีบรรทัดนั้นใน .gitignore ต้องรัน
        `git rm cached IssuerAPI/web.config` เองอีกครั้งหนึ่ง (ครั้งเดียวพอ) ไม่งั้น git ยัง track
        ไฟล์นี้ต่อ ค่าจริงด้านล่างจะหลุดไปกับ commit ถัดไปอยู่ดี
      -->
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <environmentVariable name="CONNECTION_STRING" value="server=192.100.10.46;port=3306;database=issuer;user=root;password=P@ssw0rd@1234;sslmode=None" />
        <environmentVariable name="Jwt__PrivateKey" value="MHcCAQEEIHL5i1H5negqoRXxgvJlDlgosGr2wgVeVcx2qHSkbCZdoAoGCCqGSM49AwEHoUQDQgAEEVCm54AqkodAQ9vlm3VT7UtAgpnIHsbSxjiRC8jzp2CDmo17FQGv4krTM44KJW60KudOLG6bv8rE8Qo3XncE5A==" />
        <environmentVariable name="ThaIDConfig__ClientID" value="VEU1b2MwdVREcTFwamFOYkN5ZlY1NnFQQmNQc0JOelU" />
        <environmentVariable name="ThaIDConfig__ClientSecret" value="cVVhNVU1VWVrTnlSVVEyeXdlSVFlZlZOdjF1eXBLWXdwTnhOdnFzdQ" />
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
