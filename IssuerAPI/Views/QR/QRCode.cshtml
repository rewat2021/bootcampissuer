<!doctype html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <title>QR Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- เปลี่ยนจาก THSarabunNew (fontlibrary.org) มาเป็น Kanit (Google Fonts) ตามที่เลือก — โหลดทั้งน้ำหนัก
         400 (ปกติ) และ 700 (ตัวหนา) มาด้วยเลย ต่างจาก fontlibrary.org เดิมที่ font-weight:bold ต้องแก้ปะ
         @@font-face เพิ่มเอง เพราะ Google Fonts แมป weight 700 ไว้ในชื่อ family เดียวกันให้พร้อมอยู่แล้ว -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;700&display=swap" rel="stylesheet" />
    <style>
        /* ป้องกัน scrollbar: บังคับทั้งหน้าไม่เกิน viewport แล้วให้ layout ข้างในหดตามพื้นที่ที่เหลือแทน
           การปล่อยให้เนื้อหาดันความสูง/กว้างเกินจอ (ทำเผื่อจอเล็ก/มือถือที่มักสแกน QR หน้านี้กัน) */
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        body {
            font-family: "Kanit", sans-serif;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
        }
        /* Header */
        .header {
            background-color: #002887;
            color: white;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-shrink: 0;
        }

        .header-text {
            font-size: clamp(24px, 4vh, 36px);
            font-weight: bold;
        }

        .sub-text {
            font-size: 18px;
        }
        /* Main Box */
        .container {
            flex: 1;
            min-height: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 12px;
            box-sizing: border-box;
        }

        .card {
            width: 1200px;
            max-width: 95vw;
            max-height: 100%;
            background: white;
            border: 4px solid #002887;
            border-radius: 12px;
            padding: clamp(12px, 2vh, 30px);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            box-sizing: border-box;
        }

        .qr-section {
            text-align: center;
            color: #002887;
            font-size: clamp(16px, 2.2vh, 30px);
            margin: 0 auto;
        }

            .qr-section img {
                width: clamp(140px, 28vh, 250px);
                height: auto;
            }

        /* .credential เดิม (ว่างเปล่า/comment ทิ้งไว้) เคยมี gap: 150px คั่นไว้ใน .card ทั้งที่ไม่มีเนื้อหา
           แสดงผล — เสียพื้นที่แนวนอนไปฟรีๆ และเป็นสาเหตุหนึ่งที่ทำให้ล้นจอเล็กได้ง่ายขึ้น เอา gap ออก */
        .credential {
            width: 0;
        }

            .credential h3 {
                color: #002887;
                margin-top: 5px;
                margin-bottom: 15px;
                font-size: 30px;
            }

        .credential-box {
            width: 80%;
            height: 150px;
            background-color: #0000001a;
            border-radius: 10px;
            padding: 15px 20px;
            font-size: 16px;
            word-break: break-all;
        }

        .doc-type-section {
            text-align: center;
            color: #002887;
            font-size: 22px;
            margin-bottom: 20px;
        }

            .doc-type-section select {
                font-family: inherit;
                font-size: 20px;
                padding: 6px 12px;
                border: 2px solid #002887;
                border-radius: 6px;
                color: #002887;
                margin: 0 10px;
            }

            .doc-type-section button {
                font-family: inherit;
                font-size: 20px;
                padding: 6px 18px;
                border: none;
                border-radius: 6px;
                background-color: #002887;
                color: white;
                cursor: pointer;
            }

        .countdown {
            margin-top: 10px;
            font-size: 20px;
            color: #002887;
        }

            .countdown.expiring {
                color: #c0392b;
                font-weight: bold;
            }

        .tx-code {
            margin-top: 12px;
            text-align: center;
        }

            .tx-code .tx-code-label {
                font-size: 16px;
                color: #555;
                margin-bottom: 4px;
            }

            .tx-code .tx-code-value {
                font-size: 32px;
                font-weight: bold;
                letter-spacing: 8px;
                color: #002887;
            }

        .pid-required-notice {
            font-size: 20px;
            color: #c0392b;
            margin-bottom: 15px;
        }

        .success-screen {
            display: none;
            text-align: center;
            color: #002887;
        }

            .success-screen .checkmark {
                font-size: clamp(40px, 8vh, 70px);
                color: #1f8a4c;
                line-height: 1;
                margin-bottom: 10px;
            }

            .success-screen .title {
                font-size: clamp(22px, 4vh, 32px);
                font-weight: bold;
                margin-bottom: 8px;
            }

            .success-screen .subtitle {
                font-size: 18px;
                color: #555;
            }
    </style>
</head>
<body onload="init()">
    <!-- Header -->
    <div class="header">
        <div>
            <div class="header-text">เอกสาร STANDARD VC</div>
            @* <div class="sub-text">Department of Provincial Administration</div> *@
        </div>
    </div>
    <!-- Content -->
    <div class="container">
        <div class="card">
            <div class="qr-section" id="qrSection">
                <p class="pid-required-notice" id="pidRequiredNotice" style="display:none;">
                    ยังไม่มีบัตรประชาชน (PID VC) — กรุณาสแกนเพื่อขอ PID VC ก่อน
                </p>
                <div class="doc-type-section" id="docTypeSection">
                    <label for="documentType">เลือกประเภทเอกสาร:</label>
                    <select id="documentType" onchange="getQR()">
                        <option value="IdCard">บัตรประชาชน (PID VC)</option>
                        <option value="Transcript">ใบแสดงผลการศึกษา (Transcript)</option>
                        <option value="DriverLicense">ใบขับขี่ (Driver License)</option>
                    </select>
                </div>
                <img id="qr" style="width:250px;" />
                <p><b>กรุณาสแกน QR ด้วย Digital Wallet</b></p>
                <div class="tx-code" id="txCodeBox" style="display:none;">
                    <div class="tx-code-label">กรอกรหัสนี้ใน Digital Wallet เมื่อได้รับแจ้ง</div>
                    <div class="tx-code-value" id="txCodeValue"></div>
                </div>
                <p class="countdown" id="countdown"></p>
                <p class="countdown expiring" id="errorMsg" style="display:none;"></p>
            </div>
            <div class="success-screen" id="successScreen">
                <div class="checkmark">&#10003;</div>
                <div class="title">ออกเอกสารสำเร็จแล้ว</div>
                <div class="subtitle">กรุณาตรวจสอบเอกสารใน Digital Wallet ของท่าน</div>
            </div>
            <div class="credential">
                @*  <h3>Credential Offer</h3>
                <div class="credential-box">
                    openid-credential-offer://vc-testtool.etda.or.th/?credential_offer_uri=https://vc-testtool.etda.or.th/openid4vc/credentialOffer?id=example
                </div> *@
            </div>
        </div>
    </div>
    <script>
        let countdownTimer = null;
        let statusPollTimer = null;

        function stopCountdown() {
            if (countdownTimer) {
                clearInterval(countdownTimer);
                countdownTimer = null;
            }
        }

        function stopStatusPoll() {
            if (statusPollTimer) {
                clearInterval(statusPollTimer);
                statusPollTimer = null;
            }
        }

        function showSuccessScreen() {
            stopCountdown();
            stopStatusPoll();
            document.getElementById("qrSection").style.display = "none";
            document.getElementById("successScreen").style.display = "block";
        }

        // Cross-device flow: poll until the wallet has scanned the QR, redeemed the code, and
        // successfully received the credential — then swap the QR out for a success screen instead of
        // leaving a now-useless QR on screen.
        function startStatusPoll(requestId) {
            stopStatusPoll();
            if (!requestId) return;

            statusPollTimer = setInterval(async () => {
                try {
                    const res = await fetch('/credential-offer/status?id=' + encodeURIComponent(requestId), {
                        credentials: 'include'
                    });
                    const data = await res.json();
                    if (res.ok && data.issued) {
                        showSuccessScreen();
                    }
                } catch (e) {
                    console.log("status poll error", e);
                }
            }, 3000);
        }

        function startCountdown(expiresInSeconds) {
            stopCountdown();

            const countdownEl = document.getElementById("countdown");
            let remaining = expiresInSeconds;

            function render() {
                const m = Math.floor(remaining / 60);
                const s = remaining % 60;
                countdownEl.textContent =
                    "QR หมดอายุใน " + m + ":" + String(s).padStart(2, "0");
                countdownEl.classList.toggle("expiring", remaining <= 30);
            }

            render();

            countdownTimer = setInterval(() => {
                remaining--;
                if (remaining <= 0) {
                    stopCountdown();
                    stopStatusPoll();
                    countdownEl.textContent = "QR หมดอายุแล้ว กำลังพาไปหน้าเข้าสู่ระบบใหม่...";
                    countdownEl.classList.add("expiring");
                    window.location.href = "/Account/ThaIDLogin";
                    return;
                }
                render();
            }, 1000);
        }

        let forcedDocumentType = null; // set to "IdCard" when this citizen has no PID VC yet

        // Cross-device (QR) entry point. The PID-VC-first gate (check /credential-offer/pid-status,
        // force IdCard until the citizen has one) is TEMPORARILY DISABLED per request — backend no
        // longer enforces it either (see CredentialOfferController), so forcing it here only on the
        // frontend would just be confusing. To re-enable, restore the pid-status fetch below and
        // uncomment the matching backend checks in CredentialOfferController.
        async function init() {
            // const res = await fetch('/credential-offer/pid-status', { credentials: 'include' });
            // const data = await res.json();
            //
            // if (res.ok && data.has_pid_vc === false) {
            //     forcedDocumentType = "IdCard";
            //     document.getElementById("docTypeSection").style.display = "none";
            //     document.getElementById("pidRequiredNotice").style.display = "block";
            // }

            getQR();
        }

        async function getQR() {
            stopCountdown();
            stopStatusPoll();
            document.getElementById("successScreen").style.display = "none";
            document.getElementById("qrSection").style.display = "block";

            const errorEl = document.getElementById("errorMsg");
            const qrEl = document.getElementById("qr");
            const countdownEl = document.getElementById("countdown");
            const txCodeBox = document.getElementById("txCodeBox");
            const txCodeValueEl = document.getElementById("txCodeValue");
            errorEl.style.display = "none";
            txCodeBox.style.display = "none";

            const documentType = forcedDocumentType || document.getElementById("documentType").value;
            const res = await fetch('/credential-offer', {
                method: 'POST',
                credentials: 'include', // 🔥 ถ้าใช้ login
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ document_type: documentType })
            });
            const data = await res.json();
            console.log(data);

            if (!res.ok) {
                qrEl.removeAttribute("src");
                countdownEl.textContent = "";
                errorEl.textContent = data.error === "pid_vc_required"
                    ? "ต้องขอบัตรประชาชน (PID VC) ก่อน จึงจะขอเอกสารอื่นได้"
                    : (data.error_description || "เกิดข้อผิดพลาด ไม่สามารถสร้าง QR ได้");
                errorEl.style.display = "block";
                return;
            }

            console.log(data.qr_text);
            document.getElementById("qr").src =
                "data:image/png;base64," + data.qr_text;

            // tx_code (PIN คู่กับ QR) — server ส่งกลับมาเป็น plaintext ครั้งเดียวตอนสร้าง offer เท่านั้น
            // (เก็บแค่ hash ไว้ฝั่ง server) ต้องโชว์แยกจาก QR ให้คนอ่านแล้วพิมพ์เข้า wallet เอง ตาม flow ที่
            // CredentialOfferController.GenerateCredentialOfferQr ตั้งไว้
            if (data.tx_code) {
                txCodeValueEl.textContent = data.tx_code;
                txCodeBox.style.display = "block";
            }

            if (data.expires_in) {
                startCountdown(data.expires_in);
            }

            if (data.request_id) {
                startStatusPoll(data.request_id);
            }
        }
    </script>
</body>
</html>
